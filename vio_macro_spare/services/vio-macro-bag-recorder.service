[Unit]
Description=VIO Macro ROS 2 Bag Recorder (arm-triggered, ov_msckf topics)
After=network-online.target vio-macro-stack.service
Wants=network-online.target
Requires=vio-macro-stack.service

[Service]
Type=simple
User=ituarc
Group=ituarc
WorkingDirectory=/home/ituarc/Desktop/vio_macro/bag
ExecStart=/bin/bash /home/ituarc/Desktop/vio_macro/bag/record_bag_ov_msckf_service.sh
# The recorder exits cleanly after disarm — do not restart on success.
# It will restart on unexpected failures (crashes, signals).
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment (ensure ROS domain and locale are set)
Environment="HOME=/home/ituarc"
Environment="ROS_DOMAIN_ID=0"
Environment="LANG=en_US.UTF-8"

[Install]
WantedBy=multi-user.target
